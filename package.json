{
  "name": "automation-test",
  "version": "0.1.0",
  "private": true,
  "description": "Automation test framework - Playwright, K6, and TypeScript",
  "type": "module",
  "engines": {
    "node": "26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/cli": "^0.1.22",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "dotenv": "18.0.8",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-markdown": "5.1.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-prettier": "5.5.7",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "zod": "4.6.7"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": "eslint"
  }
}
