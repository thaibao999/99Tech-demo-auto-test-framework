# Copy to .env for local settings (gitignored). CI should set vars in the workflow or secrets.
# Loaded automatically by e2e-tests/utils/env.ts. Shell/CI values take precedence over .env.
# dev | qa | staging | production  (default: qa)
# ENVIRONMENT=qa

# Optional: override profile URLs without changing ENVIRONMENT
# BASE_URL=https://www.demoblaze.com
# API_URL=https://api.demoblaze.com

# Required: password shared by all test accounts (login/order test data). No default.
# TEST_ACCOUNT_PASSWORD=
