{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "@playwright/test"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@@e2e-tests/*": ["./e2e-tests/*"],
    }
  },
  "include": [
    "e2e-tests/**/*.ts",
    "playwright.config.ts"
  ]
}
